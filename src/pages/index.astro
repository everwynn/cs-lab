---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="CS Lab - 计算机基础可视化学习平台">
  <!-- Hero Section -->
  <section class="max-w-6xl mx-auto px-6 pt-20 pb-12">
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-accent-dark dark:text-accent text-sm font-medium">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        交互式学习
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white leading-tight">
        计算机基础可视化
      </h1>
      <p class="text-lg text-gray-600 dark:text-slate-400 max-w-2xl leading-relaxed">
        算法 · 数据结构 · 设计模式 · Git 工作流
      </p>
      <p class="text-sm text-gray-500 dark:text-slate-500 max-w-2xl">
        通过逐步动画与代码高亮，理解计算机科学核心概念，建立扎实的工程基础。
      </p>
    </div>
  </section>

  <!-- 板块入口 -->
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <!-- 算法可视化 -->
      <a href="${baseUrl}algorithms" class="group p-6 rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900/40 hover:border-accent/50 hover:shadow-lg transition-all">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-purple-50 dark:bg-purple-900/20 flex items-center justify-center text-2xl">🫧</div>
          <div class="flex-1">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-accent-dark dark:group-hover:text-accent transition-colors">算法可视化</h3>
            <p class="text-sm text-gray-500 dark:text-slate-400">排序、搜索、图论算法逐步演示，代码同步高亮</p>
          </div>
          <svg class="w-5 h-5 text-gray-300 dark:text-slate-600 group-hover:text-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </div>
      </a>
      <!-- 数据结构 -->
      <a href="${baseUrl}data-structures" class="group p-6 rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900/40 hover:border-accent/50 hover:shadow-lg transition-all">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-teal-50 dark:bg-teal-900/20 flex items-center justify-center text-2xl">📦</div>
          <div class="flex-1">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-accent-dark dark:group-hover:text-accent transition-colors">数据结构</h3>
            <p class="text-sm text-gray-500 dark:text-slate-400">栈、队列、链表、哈希表、树等结构的动态演示</p>
          </div>
          <svg class="w-5 h-5 text-gray-300 dark:text-slate-600 group-hover:text-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </div>
      </a>
      <!-- 设计模式 -->
      <a href="${baseUrl}design-patterns" class="group p-6 rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900/40 hover:border-accent/50 hover:shadow-lg transition-all">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-orange-50 dark:bg-orange-900/20 flex items-center justify-center text-2xl">🏗️</div>
          <div class="flex-1">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-accent-dark dark:group-hover:text-accent transition-colors">设计模式</h3>
            <p class="text-sm text-gray-500 dark:text-slate-400">单例、工厂、观察者、策略、装饰器等经典模式</p>
          </div>
          <svg class="w-5 h-5 text-gray-300 dark:text-slate-600 group-hover:text-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </div>
      </a>
      <!-- Git 工作流 -->
      <a href="${baseUrl}git-workflow" class="group p-6 rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900/40 hover:border-accent/50 hover:shadow-lg transition-all">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-rose-50 dark:bg-rose-900/20 flex items-center justify-center text-2xl">🌿</div>
          <div class="flex-1">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-accent-dark dark:group-hover:text-accent transition-colors">Git 工作流</h3>
            <p class="text-sm text-gray-500 dark:text-slate-400">分支、合并、Rebase、冲突、Git Flow 可视化</p>
          </div>
          <svg class="w-5 h-5 text-gray-300 dark:text-slate-600 group-hover:text-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>
