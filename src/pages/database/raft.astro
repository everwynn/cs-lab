---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RaftVisualizer from '../../components/database/RaftVisualizer.vue';
import { raftDefinition } from '../../components/database/raftDefinition';

const topic = raftDefinition;
---

<BaseLayout title={`${topic.name} - 数据库与分布式`} description={topic.desc}>
  <section class="max-w-6xl mx-auto px-6 py-12">
    <a href="/database" class="inline-flex items-center gap-1 text-sm text-gray-500 dark:text-slate-400 hover:text-accent-dark dark:hover:text-accent mb-6 transition-colors">
      ← 返回数据库与分布式列表
    </a>
    <RaftVisualizer client:load />
  </section>
</BaseLayout>
