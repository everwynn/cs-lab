---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allGitTopics } from '../../components/git/gitDefinitions';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Git 工作流可视化 - Demo Center" description="Git 分支、合并、Rebase、冲突解决、Git Flow 的动画可视化演示">
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-8">
    <div class="space-y-3 mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-accent-dark dark:text-accent text-sm font-medium">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        动画演示 · 命令同步 · 纯前端
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">Git 工作流可视化</h1>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">
        通过动画展示 Git 分支、合并、冲突等操作过程，commit 图实时更新，Shell 命令同步高亮。
        共 <strong class="text-accent-dark dark:text-accent">{allGitTopics.length}</strong> 个核心主题。
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {allGitTopics.map((topic) => (
        <a
          href={`${baseUrl}git-workflow/${topic.id}`}
          class="group block p-5 rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900/40 hover:border-accent/50 dark:hover:border-accent/50 hover:shadow-md transition-all"
        >
          <div class="flex items-start justify-between mb-3">
            <span class="text-3xl">{topic.icon}</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
              Git
            </span>
          </div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-accent-dark dark:group-hover:text-accent transition-colors mb-2">
            {topic.name}
          </h3>
          <p class="text-sm text-gray-600 dark:text-slate-400 mb-3 line-clamp-2">
            {topic.desc}
          </p>
          <div class="text-xs text-gray-500 dark:text-slate-500">
            场景：{topic.scenario}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
