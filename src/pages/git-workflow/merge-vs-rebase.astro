---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GitVisualizer from '../../components/git/GitVisualizer.vue';
import { allGitTopics } from '../../components/git/gitDefinitions';

const topic = allGitTopics.find(t => t.id === 'merge-vs-rebase')!;
---

<BaseLayout title={`${topic.name} - Git 工作流可视化`} description={topic.desc}>
  <section class="max-w-6xl mx-auto px-6 py-12">
    <a href="/git-workflow" class="inline-flex items-center gap-1 text-sm text-gray-500 dark:text-slate-400 hover:text-accent-dark dark:hover:text-accent mb-6 transition-colors">
      ← 返回 Git 工作流列表
    </a>
    <div class="mb-6">
      <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
        <span>{topic.icon}</span> {topic.name}
      </h1>
      <p class="text-sm text-gray-500 dark:text-slate-400 mt-2">{topic.desc}</p>
      <div class="mt-3 p-3 rounded-lg bg-gray-50 dark:bg-slate-900/30 border border-gray-100 dark:border-slate-800 text-sm text-gray-600 dark:text-slate-400">
        <strong class="text-gray-900 dark:text-slate-200">场景：</strong>{topic.scenario}
      </div>
    </div>
    <GitVisualizer client:load topicId="merge-vs-rebase" />
  </section>
</BaseLayout>
