---
import BaseLayout from '../layouts/BaseLayout.astro';

const techStack = [
  { name: 'Astro', desc: '静态站点生成器' },
  { name: 'Vue 3', desc: '交互式组件' },
  { name: 'Tailwind CSS', desc: '样式框架' },
  { name: 'TypeScript', desc: '类型安全' },
  { name: 'SVG', desc: '动态可视化' },
];
---

<BaseLayout title="关于 - CS Lab" description="关于 CS Lab 计算机基础可视化学习平台">
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">关于 CS Lab</h1>

    <div class="prose dark:prose-invert max-w-none">
      <p>
        <strong>CS Lab</strong> 是一个计算机基础知识的交互式可视化学习平台，通过逐步动画与代码同步高亮，帮助学习者理解 <strong>算法、数据结构、设计模式</strong> 和 <strong>Git 工作流</strong> 等核心概念。
      </p>

      <p>
        每个主题都包含 <strong>可视化动画</strong>、<strong>步骤说明</strong> 和 <strong>Java 代码实现</strong>，学习者可以播放、暂停、单步前进后退，按照自己的节奏理解每一个细节。
      </p>

      <h2>当前覆盖内容</h2>
      <ul>
        <li><strong>算法</strong> — 排序、搜索、图论等经典算法的执行过程可视化</li>
        <li><strong>数据结构</strong> — 栈、队列、链表、哈希表、二叉树、堆、Trie、并查集等结构</li>
        <li><strong>设计模式</strong> — 单例、工厂、观察者、策略、装饰器等常用模式</li>
        <li><strong>Git 工作流</strong> — 分支、合并、Rebase、冲突解决、Git Flow 等协作流程</li>
      </ul>

      <h2>技术栈</h2>
    </div>

    <!-- 技术栈标签 -->
    <div class="flex flex-wrap gap-3 mt-6">
      {techStack.map((tech) => (
        <div class="px-4 py-2 rounded-lg bg-white dark:bg-slate-900/50 border border-gray-200 dark:border-slate-800 text-center">
          <div class="text-sm font-medium text-gray-900 dark:text-white">{tech.name}</div>
          <div class="text-xs text-gray-500 dark:text-slate-500">{tech.desc}</div>
        </div>
      ))}
    </div>

    <!-- 相关链接 -->
    <div class="mt-12 p-6 rounded-xl bg-gray-50 dark:bg-slate-900/50 border border-gray-200 dark:border-slate-800">
      <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-3">相关链接</h2>
      <p class="text-sm text-gray-600 dark:text-slate-400 mb-3">
        查看这些概念在真实项目中的应用：
      </p>
      <div class="flex flex-wrap gap-4 text-sm">
        <a href="https://github.com/everwynn/cs-lab" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-accent-dark dark:text-accent hover:underline">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          </svg>
          GitHub 仓库
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
