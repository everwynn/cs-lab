---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlgorithmFilter from '../../components/algorithms/AlgorithmFilter.vue';
import { categories } from '../../utils/algorithmCategories';

const availableCount = categories.reduce((sum, cat) => sum + cat.algorithms.filter(a => a.available).length, 0)
const totalCount = categories.reduce((sum, cat) => sum + cat.algorithms.length, 0)
---

<BaseLayout title="算法可视化 - Demo Center" description="排序、搜索、图论等经典算法的动画可视化演示，逐步骤展示算法执行过程，Java 代码同步高亮">
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-8">
    <div class="space-y-3 mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-accent-dark dark:text-accent text-sm font-medium">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        动画演示 · 代码同步 · 纯前端
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">算法可视化演示</h1>
      <p class="text-gray-600 dark:text-slate-400 max-w-2xl">
        通过动画逐步展示算法执行过程，数据状态可视化，代码行同步高亮当前执行步骤。
        目前共 <strong class="text-accent-dark dark:text-accent">{availableCount}</strong> 个算法可用，
        <strong class="text-gray-500 dark:text-slate-500">{totalCount - availableCount}</strong> 个正在开发中。
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-20">
    <AlgorithmFilter client:load categories={categories} />
  </section>
</BaseLayout>
