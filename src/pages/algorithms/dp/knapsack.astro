---
const baseUrl = import.meta.env.BASE_URL;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DpVisualizer from '../../../components/algorithms/DpVisualizer.vue';

const algoName = '0/1 背包问题';
const algoDesc = '在背包容量限制下，选择物品使总价值最大。二维 DP 表格逐格填充，展示选/不选决策';
---

<BaseLayout title={`${algoName} - 算法可视化演示`} description={algoDesc}>
  <section class="max-w-6xl mx-auto px-6 py-12">
    <a href="${baseUrl}algorithms" class="inline-flex items-center gap-1 text-sm text-gray-500 dark:text-slate-400 hover:text-accent-dark dark:hover:text-accent mb-6 transition-colors">
      ← 返回算法列表
    </a>
    <div class="mb-6">
      <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">{algoName}</h1>
      <p class="text-sm text-gray-500 dark:text-slate-400 mt-2">{algoDesc}</p>
      <div class="mt-3 p-3 rounded-lg bg-gray-50 dark:bg-slate-900/30 border border-gray-100 dark:border-slate-800 text-sm text-gray-600 dark:text-slate-400">
        <strong class="text-gray-900 dark:text-slate-200">场景：</strong>投资组合、货物装载、资源分配等。每件物品只能选 0 或 1 次（不可分割），是 NP-hard 问题的经典近似方案。
      </div>
    </div>
    <DpVisualizer client:load algorithm="knapsack" />
  </section>
</BaseLayout>
