---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DpVisualizer from '../../../components/algorithms/DpVisualizer.vue';

const algoName = '斐波那契（动态规划）';
const algoDesc = '自底向上填充 DP 表格，避免递归重复计算，O(n) 求解第 n 项';
---

<BaseLayout title={`${algoName} - 算法可视化演示`} description={algoDesc}>
  <section class="max-w-6xl mx-auto px-6 py-12">
    <a href="/algorithms" class="inline-flex items-center gap-1 text-sm text-gray-500 dark:text-slate-400 hover:text-accent-dark dark:hover:text-accent mb-6 transition-colors">
      ← 返回算法列表
    </a>
    <div class="mb-6">
      <h1 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">{algoName}</h1>
      <p class="text-sm text-gray-500 dark:text-slate-400 mt-2">{algoDesc}</p>
      <div class="mt-3 p-3 rounded-lg bg-gray-50 dark:bg-slate-900/30 border border-gray-100 dark:border-slate-800 text-sm text-gray-600 dark:text-slate-400">
        <strong class="text-gray-900 dark:text-slate-200">场景：</strong>爬楼梯方案数、兔子繁殖、金融复利近似等。朴素递归 O(2^n)，DP 优化为 O(n)。
      </div>
    </div>
    <DpVisualizer client:load algorithm="fibonacci" />
  </section>
</BaseLayout>
