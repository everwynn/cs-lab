---
interface Props {
  site: 'station' | 'cs-lab' | 'lucky-hub' | 'pulse-hub' | 'repo-rank' | 'tech-radar';
  class?: string;
  /** 全站数字前的限定词。门户页脚还有 6 站汇总，用「全站」会与汇总混淆，传「本站」区分 */
  scopeLabel?: string;
}

const { site, class: className, scopeLabel = '全站' } = Astro.props;
---

<span
  class:list={['visit-counter', className]}
  data-visit-counter
  data-site={site}
  data-scope-label={scopeLabel}
  title="匿名访问统计，不收集个人身份信息"
  hidden></span>

<script>
  const ENDPOINT = 'https://stats.everwynn.me/hit';

  const el = document.querySelector<HTMLElement>('[data-visit-counter]');
  const site = el?.dataset.site;
  const scopeWord = el?.dataset.scopeLabel || '全站';
  const params = new URLSearchParams(location.search);
  const isDevOptIn = params.has('stats-dev');

  const readFlag = (key: string) => {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  };

  const skip =
    !el ||
    !site ||
    (!isDevOptIn && location.hostname !== 'everwynn.github.io') ||
    navigator.doNotTrack === '1' ||
    (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl === true ||
    params.has('notrack') ||
    readFlag('ew:no-track') === '1';

  const format = (value: number) => value.toLocaleString('zh-CN');

  if (!skip) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), 8000);

    fetch(ENDPOINT, {
      method: 'POST',
      headers: { 'content-type': 'text/plain;charset=UTF-8' },
      body: JSON.stringify({ s: site, p: location.pathname }),
      keepalive: true,
      signal: controller.signal,
    })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data || typeof data.page !== 'number' || data.page < 1) return;
        el.textContent =
          `本页 ${format(data.page)} 次浏览 · ${scopeWord} ${format(data.site)} 次 · 近 30 天 ${format(data.d30)}`;
        el.hidden = false;
      })
      .catch(() => {})
      .finally(() => clearTimeout(timer));
  }
</script>

<style>
  .visit-counter {
    font-variant-numeric: tabular-nums;
  }
</style>
